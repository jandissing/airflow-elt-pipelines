# Copy this file to .env and replace every placeholder before starting the stack:
#   cp .env.example .env
#
# Generate the Fernet key (must be 32 urlsafe-base64 bytes, not an arbitrary string):
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Generate each of the other two secrets (use a different value for each):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# NOTE: POSTGRES_PASSWORD appears twice below - on its own line and inside
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN. Both must carry the same value.

# --- Airflow runtime ---
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# --- Secrets (do NOT commit the filled-in .env) ---
AIRFLOW__CORE__FERNET_KEY=generate-me-see-header
AIRFLOW__API__SECRET_KEY=generate-me-see-header
AIRFLOW__API_AUTH__JWT_SECRET=generate-me-see-header

# --- Airflow UI login (created on first startup) ---
AIRFLOW_ADMIN_PASSWORD=admin

# --- PostgreSQL (warehouse + Airflow metadata DB) ---
POSTGRES_USER=airflow_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow_db
DB_HOST=postgres
DB_PORT=5432

# --- Airflow metadata DB connection (must match the values above) ---
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow_user:change-me@postgres:5432/airflow_db
