# Copy to .env and fill in the values before starting the stack:
#   cp .env.example .env
#
# Generate the two secrets with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Airflow runtime ---
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# --- Secrets (do NOT commit the filled-in .env) ---
AIRFLOW__CORE__FERNET_KEY=generate-me
AIRFLOW__API__SECRET_KEY=generate-me
AIRFLOW__API_AUTH__JWT_SECRET=generate-me

# --- Airflow UI login (created on first startup) ---
AIRFLOW_ADMIN_PASSWORD=admin

# --- PostgreSQL (warehouse + Airflow metadata DB) ---
POSTGRES_USER=airflow_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow_db
DB_HOST=postgres
DB_PORT=5432

# --- Airflow metadata DB connection (must match the values above) ---
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow_user:change-me@postgres:5432/airflow_db
